{
  "name": "keeppass-vault",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "node scripts/generate-version.js && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=22"
  }
}
