# ==============================================================================
# KeepPass Vault & Ghest Manager - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Studio & General Setup
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. Admin Security & Release Management
# ------------------------------------------------------------------------------
# نام کاربری مدیر سامانه در فرانت‌اند جهت نمایش اعلان‌ها و دسترسی به تب دیپلوی
VITE_ADMIN_USERNAME="admin"

# کلید مخفی احراز هویت ادمین در سمت بک‌اند برای محافظت از اندپوینت /api/trigger-deploy
ADMIN_SECRET_KEY="your_super_secret_admin_key_here"

# ------------------------------------------------------------------------------
# 3. GitHub Actions CI/CD Integration
# ------------------------------------------------------------------------------
# توکن دسترسی اختصاصی گیت‌هاب (Personal Access Token با دسترسی repo و workflow)
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# نام کاربری یا سازمان مالک مخزن گیت‌هاب
GITHUB_REPO_OWNER="siteirdood"

# نام مخزن در گیت‌هاب
GITHUB_REPO_NAME="keeppass-vault"

# ------------------------------------------------------------------------------
# 4. Cloudflare Pages / Workers Deployment Secrets
# (این متغیرها باید در بخش GitHub Repo Secrets ذخیره شوند)
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_PROJECT_NAME="keeppass-vault"

# ------------------------------------------------------------------------------
# 5. Database (Optional for backup script)
# ------------------------------------------------------------------------------
DATABASE_URL="postgres://user:password@localhost:5432/keeppass_db"
